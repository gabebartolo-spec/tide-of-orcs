{
  "name": "tide-of-orcs",
  "version": "0.1.0",
  "description": "A relaxing incremental tower-defence game: an elf archer holds the fence against an endless orc tide.",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src sim && tsc --noEmit",
    "balance": "tsx sim/run.ts",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": "true",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
